# Base URL of the WeCooked REST API. NOT a secret — safe to commit.
# Defaults to http://localhost:5000/api/v1 (the local apps/api server) when
# unset, so local development needs no override. Set this for other
# environments, e.g. a deployed API.
VITE_API_BASE_URL=http://localhost:5000/api/v1

# Firebase web config for the still-Firebase-backed admin areas (Overview /
# Recipes / Users tabs, and the sign-up / password-reset / profile flows).
# These are public client identifiers, not server secrets. Firebase/Firestore
# is temporary and will be removed as each feature migrates to the REST API.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
