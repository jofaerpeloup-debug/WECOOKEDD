NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/wecooked_dev
CORS_ORIGINS=http://localhost:5173,http://localhost:19006

# Must be a high-entropy secret of at least 32 characters. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-this-with-a-generated-secret-at-least-32-chars-long
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12

# Transactional email / password reset. Use a Resend sending-only API key and
# a verified sender. The URL must be a fixed base with no query/fragment/
# credentials of its own — the API appends the one-time token. Accepted
# schemes: http/https (a future web landing page — token appended as a URL
# FRAGMENT, so it's never sent to a server) or wecooked: (the mobile app's own
# deep-link scheme — token appended as a QUERY param, e.g.
# wecooked://reset-password?token=...). https is required in production for
# the http(s) case; wecooked: is accepted in every environment, since it is
# this project's own already-shipped mobile scheme, not a web protocol.
RESEND_API_KEY=replace-with-resend-sending-api-key
EMAIL_FROM=WeCooked <no-reply@example.com>
PASSWORD_RESET_URL=http://localhost:5173/reset-password
PASSWORD_RESET_TTL_MINUTES=30

# Email verification. Same URL conventions as PASSWORD_RESET_URL above.
EMAIL_VERIFICATION_URL=http://localhost:5173/verify-email
EMAIL_VERIFICATION_TTL_MINUTES=1440

# Approved Web/server Google OAuth client ID(s) accepted as ID-token audiences.
# Comma-separated for safe rotation or multiple intentional server audiences.
# Android/iOS platform client IDs do not normally belong here. No secret is used.
GOOGLE_OAUTH_CLIENT_IDS=your-web-server-client-id.apps.googleusercontent.com
